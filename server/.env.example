# Copier vers .env et remplir les valeurs. Ne jamais commiter .env.
# Base PostgreSQL (locale ou hébergée)
DATABASE_URL=postgres://user:password@localhost:5432/esystem
# Secret de signature JWT — 32 caractères minimum, aléatoire, différent en production
JWT_SECRET=change-moi-en-production-32-caracteres-minimum
# Port d'écoute de l'API
PORT=3000
# Clé de chiffrement des secrets de paiement (AES-256-GCM) — 64 caractères
# hex (32 octets) ou base64. Générer avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sans elle, la configuration des moyens de paiement est refusée (500).
PAYMENT_SECRETS_KEY=
# E-mails (modules 15-16, optionnels) : sans SMTP_HOST / SMTP_USER /
# SMTP_PASS / SMTP_FROM, aucun e-mail n'est envoyé (email_envoye: false) et
# l'admin transmet les liens lui-même (invitation, réinitialisation).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="e-System Church <no-reply@example.org>"
# URL publique de l'application web, pour les liens ?token=... envoyés
# par e-mail (réinitialisation / invitation).
APP_URL=http://localhost:8080
